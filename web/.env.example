# Copie para .env e preencha (NUNCA commite o .env)

# PostgreSQL (ex.: Neon — use URL com sslmode=require)
# Se no Windows aparecer "fetch failed" / erro de SSL, tente REMOVER da URL o parâmetro: channel_binding=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Segredo para cookies JWT do admin (mín. 16 caracteres)
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"

# Senha inicial do usuário admin no seed (opcional)
# SEED_ADMIN_PASSWORD="admin123"
